# ==== Frontend — Environment Variables (Vercel) ====

# --- Public (bundled into the browser — client-safe only) ---
NEXT_PUBLIC_MAIN_API_URL=http://localhost:5001
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000

# --- Server-only (used by middleware.ts on the edge/server, never sent to the browser) ---
# This is the PUBLIC verification key (safe to hold here) — never the private key.
# Same value as auth-service's JWT_PUBLIC_KEY_BASE64.
JWT_PUBLIC_KEY_
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=hackathon-platform
