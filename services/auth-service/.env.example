# ==== Auth Service — Environment Variables ====
NODE_ENV=development
PORT=5000
SERVICE_NAME=auth-service

# Comma-separated origins allowed to send/receive cookies (your Vercel frontend + local dev)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---- Database (owns the user store) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_DATABASE=auth_db

# ---- JWT (asymmetric RS256) ----
# This service is the ONLY one holding the private key.
# Generate a keypair with: npm run generate-keys
# Paste the PEM contents base64-encoded (openssl base64 -A -in key.pem) so they survive
# as single-line env vars on Azure App Service / Vercel.
JWT_PRIVATE_KEY_
JWT_PUBLIC_KEY_
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=hackathon-platform
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Key id, bump when rotating keys so old tokens can still be checked against a JWKS-style map
JWT_KID=key-1

# Cookie attributes (cross-site cookie from Azure -> Vercel needs SameSite=None; Secure)
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Namespace so this service can be dropped into any hackathon repo unmodified
PROJECT_NAME=hackathon-template
