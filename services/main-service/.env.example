# ==== Main Service — Environment Variables ====
NODE_ENV=development
PORT=5001
SERVICE_NAME=main-service

CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---- JWT (verifies tokens issued by auth-service; NEVER put a private key here) ----
# Paste the SAME public key printed by `auth-service: npm run generate-keys`.
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=hackathon-platform

# ---- Supabase (this service's relational data store) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Service-role key: full-access, server-only. NEVER send to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (caching, rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Downstream service (internal call, not exposed to the browser) ----
AI_STORAGE_SERVICE_URL=http://localhost:5002
# Shared secret so ai-storage-service can trust server-to-server calls (see docs/security.md)
INTERNAL_SERVICE_TOKEN=change_me_internal_token

PROJECT_NAME=hackathon-template
