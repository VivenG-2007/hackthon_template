# ==== AI + Storage Service — Environment Variables ====
NODE_ENV=development
PORT=5002
SERVICE_NAME=ai-storage-service

CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---- JWT (verifies tokens issued by auth-service; public key only) ----
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=hackathon-platform

# Shared secret checked when calls arrive via main-service's proxy (defense in depth)
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# ---- MongoDB (conversations, generated content, file metadata, logs) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_DATABASE=ai_storage_db

# ---- Redis (AI response caching, rate limiting, temp state) ----
REDIS_URL=redis://localhost:6379

# ---- Azure Blob Storage ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=hackathon-uploads
# Max upload size in bytes (default 25MB)
MAX_UPLOAD_BYTES=26214400

# ---- AI provider (swap freely — see src/services/aiProviders/) ----
# Supported out of the box: "groq", "openai", "azure-openai", "mock"
AI_PROVIDER=mock
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=
# Only needed for AI_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

PROJECT_NAME=hackathon-template
